\#{
  LaTeX resume template, compiled with Tectonic (XeTeX engine).

  Jinja's delimiters are remapped in pipeline/render/latex.py because the defaults
  collide with LaTeX's own braces. In this file: statements use a backslash-BLOCK tag,
  expressions a backslash-VAR tag, comments a backslash-hash tag like this one. Note
  that a single closing brace ends any of them, so an expression must not contain one.

  Geometry and type sizes mirror templates/styles/print.css. When a token changes there,
  change it here too — the two engines must produce the same page.
}
\documentclass[11pt,a4paper]{article}

\#{ --- Fonts. fontspec requires XeTeX/LuaTeX; Tectonic gives us XeTeX. --- }
\usepackage{fontspec}
\usepackage{xeCJK}

\#{ Noto covers Latin and CJK in one family, so a stray English word inside Chinese
   text keeps a consistent face rather than falling back to something mismatched. }
\setmainfont{\VAR{fonts.serif}}
\setsansfont{\VAR{fonts.sans}}
\setCJKmainfont{\VAR{fonts.cjk_serif}}
\setCJKsansfont{\VAR{fonts.cjk_sans}}

\#{ Symbols the Latin faces lack. Noto Serif has neither the bullet marker U+25AA nor the
   arrows U+2192 and U+2194 that appear in project descriptions, so XeTeX drew them as
   tofu boxes -- visible only in a rendered page, never in the source or the text layer.
   Declaring one command per symbol from a font that does have them is more predictable
   than a global fallback chain, which would silently change other glyphs too. }
\newfontfamily\symbolfont{\VAR{fonts.symbol}}
\newcommand{\bulletmark}{{\symbolfont \VAR{bullet_marker}}}
\newcommand{\arrowright}{{\symbolfont \VAR{arrow_right}}}
\newcommand{\arrowboth}{{\symbolfont \VAR{arrow_both}}}

\#{ Let CJK lines break between any two ideographs (LaTeX otherwise looks for spaces,
   which Chinese does not have) and allow stretch so lines are not overfull. }
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

\usepackage[
  a4paper,
  top=\VAR{geometry.margin_y},
  bottom=\VAR{geometry.margin_y},
  left=\VAR{geometry.margin_x},
  right=\VAR{geometry.margin_x}
]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{xcolor}
\usepackage[hidelinks]{hyperref}
\usepackage{tabularx}
\usepackage{ragged2e}

\definecolor{ink}{HTML}{111111}
\definecolor{inkmuted}{HTML}{444444}
\color{ink}

\#{ Ragged right: justified text opens rivers in a narrow single column. }
\RaggedRight
\setlength{\parindent}{0pt}
\pagestyle{empty}

\#{ Section headings: uppercase for Latin, plus a thin rule, matching the CSS.

   Two traps here, both learned by compiling.

   First: the before-code argument must NOT reference the title parameter. titlesec builds
   its internal section macro from its own sixth parameter, so a nested parameter
   reference there aborts with "Illegal parameter number". The title text is appended
   after before-code automatically, so an uppercasing switch belongs at the end of the
   format argument instead.

   Second: no closing brace may appear anywhere in one of these comments. The comment
   delimiter is a single closing brace, so a brace inside the prose ends the comment and
   the rest leaks into the document as body text -- which then errors as
   "Missing begin document" from a line that looks fine in the template.

   case-switch below is empty for Chinese; uppercasing is meaningless for CJK. }
\titleformat{\section}
  {\normalfont\sffamily\bfseries\fontsize{\VAR{sizes.section}}{\VAR{sizes.section_leading}}\selectfont\VAR{case_switch}}
  {}{0em}{}[{\vspace{-\VAR{rules.gap}}\rule{\linewidth}{\VAR{rules.weight}}}]
\titlespacing*{\section}{0pt}{\VAR{spacing.section}}{\VAR{rules.gap}}

\#{ Bullets: same glyph and indent as the CSS marker.

   The marker is the literal U+25AA glyph, not \blacksquare — that command needs amssymb,
   and its absence made every LaTeX render fail with "Undefined control sequence". Using
   the same character as print.css and docx.py also keeps the three renderers identical
   rather than approximately similar. }
\setlist[itemize]{
  leftmargin=\VAR{spacing.bullet_indent},
  itemsep=\VAR{spacing.bullet},
  parsep=0pt,
  topsep=\VAR{spacing.bullet_top},
  partopsep=0pt,
  label={\footnotesize\raisebox{0.15ex}{\bulletmark}}
}

\#{ Title left, date right, on one baseline — the flex row from the CSS. }
\newcommand{\entryhead}[2]{%
  \begin{tabularx}{\linewidth}{@{}Xr@{}}
    \textbf{\fontsize{\VAR{sizes.item_title}}{\VAR{sizes.item_title_leading}}\selectfont #1} &
    {\color{inkmuted}\fontsize{\VAR{sizes.item_meta}}{\VAR{sizes.item_meta_leading}}\selectfont #2}
  \end{tabularx}%
}

\#{ Second line: role and dates. Upright in Chinese — synthesised obliques on CJK
   faces look broken, so weight carries the distinction instead. }
\newcommand{\entrysub}[2]{%
  \begin{tabularx}{\linewidth}{@{}Xr@{}}
    {\color{inkmuted}\VAR{emph_open}\fontsize{\VAR{sizes.item_meta}}{\VAR{sizes.item_meta_leading}}\selectfont #1\VAR{emph_close}} &
    {\color{inkmuted}\fontsize{\VAR{sizes.item_meta}}{\VAR{sizes.item_meta_leading}}\selectfont #2}
  \end{tabularx}%
}

\fontsize{\VAR{sizes.body}}{\VAR{sizes.body_leading}}\selectfont

\begin{document}

\#{ --- Header --- }
\begin{center}
  {\sffamily\bfseries\fontsize{\VAR{sizes.name}}{\VAR{sizes.name_leading}}\selectfont
   \VAR{tex(resume.profile.name)}}\\[\VAR{spacing.after_name}]
\BLOCK{ set contacts = resume.profile.contact_line() }
\BLOCK{ if contacts }
  {\color{inkmuted}\fontsize{\VAR{sizes.contact}}{\VAR{sizes.contact_leading}}\selectfont
   \VAR{contacts | map('tex') | join(separators.contact)}}
\BLOCK{ endif }
\BLOCK{ if resume.profile.summary }
  \\[\VAR{spacing.after_name}]
  {\fontsize{\VAR{sizes.body}}{\VAR{sizes.body_leading}}\selectfont \VAR{tex(resume.profile.summary)}}
\BLOCK{ endif }
\end{center}

\#{ --- Education --- }
\BLOCK{ set education = resume.sorted_education() }
\BLOCK{ if education }
\section{\VAR{tex(labels.education)}}
\BLOCK{ for item in education }
\entryhead{\VAR{tex(item.institution)}}{\VAR{tex(fmt_education_date(item))}}
\BLOCK{ set degree_line = fmt_degree(item) }
\BLOCK{ if degree_line }
\entrysub{\VAR{tex(degree_line)}}{}
\BLOCK{ endif }
\BLOCK{ if item.bullets }
\begin{itemize}
\BLOCK{ for bullet in item.bullets }
  \item \VAR{tex(bullet)}
\BLOCK{ endfor }
\end{itemize}
\BLOCK{ endif }
\BLOCK{ if not loop.last }\vspace{\VAR{spacing.item}}\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

\#{ --- Experience --- }
\BLOCK{ set experiences = resume.sorted_experiences() }
\BLOCK{ if experiences }
\section{\VAR{tex(labels.experience)}}
\BLOCK{ for item in experiences }
\entryhead{\VAR{tex(item.organization)}}{\VAR{tex(item.location or '')}}
\entrysub{\VAR{tex(item.role)}}{\VAR{tex(fmt_range(item.start, item.end))}}
\begin{itemize}
\BLOCK{ for bullet in item.bullets }
  \item \VAR{tex(bullet)}
\BLOCK{ endfor }
\end{itemize}
\BLOCK{ if not loop.last }\vspace{\VAR{spacing.item}}\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

\#{ --- Projects --- }
\BLOCK{ set projects = resume.sorted_projects() }
\BLOCK{ if projects }
\section{\VAR{tex(labels.projects)}}
\BLOCK{ for item in projects }
\entryhead{\VAR{tex(item.name)}}{\VAR{tex(item.context or fmt_month(item.date_))}}
\begin{itemize}
\BLOCK{ for bullet in item.bullets }
  \item \VAR{tex(bullet)}
\BLOCK{ endfor }
\end{itemize}
\BLOCK{ if not loop.last }\vspace{\VAR{spacing.item}}\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

\#{ --- Publications --- }
\BLOCK{ set publications = resume.sorted_publications() }
\BLOCK{ if publications }
\section{\VAR{tex(labels.publications)}}
\BLOCK{ for item in publications }
\entryhead{\VAR{tex(item.title)}}{\VAR{tex(item.venue or fmt_month(item.date_))}}
\BLOCK{ if item.authors }
\entrysub{\VAR{tex(item.authors)}}{}
\BLOCK{ endif }
\BLOCK{ if item.bullets }
\begin{itemize}
\BLOCK{ for bullet in item.bullets }
  \item \VAR{tex(bullet)}
\BLOCK{ endfor }
\end{itemize}
\BLOCK{ endif }
\BLOCK{ if not loop.last }\vspace{\VAR{spacing.item}}\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

\#{ --- Skills: one row per category, label left, values flowing right --- }
\BLOCK{ set skill_groups = resume.skills_by_category() }
\BLOCK{ if skill_groups }
\section{\VAR{tex(labels.skills)}}
\begin{itemize}[label={},leftmargin=0pt,itemsep=\VAR{spacing.bullet}]
\BLOCK{ for category, skills in skill_groups.items() }
  \item \textbf{\VAR{tex(labels.skill_categories[category.value])}:}\ \VAR{skills | map('fmt_skill_tex') | join(skill_join)}
\BLOCK{ endfor }
\end{itemize}
\BLOCK{ endif }

\end{document}
