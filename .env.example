# Copy to .env for local development. Deployment reads this same file:
# `scripts/deploy_cloudrun.sh --secrets` loads the values into GCP Secret Manager, so
# there is no dashboard to fill in by hand.
#
# Every variable the code reads is listed here. Commented-out lines already have a working
# default in pipeline/config.py — uncomment only to override.
#
# ONLY SIX MUST BE SUPPLIED BY HAND: BEDROCK_API_KEY, NOTION_TOKEN, SLACK_BOT_TOKEN,
# SLACK_SIGNING_SECRET, SLACK_DM_CHANNEL, GITHUB_TOKEN. APPROVAL_HMAC_SECRET and
# TRIGGER_TOKEN are generated by the deploy script, and PUBLIC_BASE_URL is filled in from
# the Cloud Run URL once the service exists.
#
# ANTHROPIC_API_KEY is NOT one of them: the default provider is Bedrock. It is only needed
# if you set LLM_PROVIDER=anthropic.

# --- LLM ---------------------------------------------------------------------
# Which surface to call Claude through: "bedrock" (default) or "anthropic".
# LLM_PROVIDER=bedrock

# Model ID WITHOUT a provider prefix. The code adds Bedrock's `anthropic.` prefix
# automatically, so this one value is correct on either provider.
# LLM_MODEL=claude-opus-5

# --- Bedrock (used when LLM_PROVIDER=bedrock) --------------------------------
# The Bedrock API key, from the AWS console: Amazon Bedrock -> API keys.
# Starts with `bedrock-api-key-`.
#
# SHORT-TERM KEYS EXPIRE (up to 12 hours), so treat this as a starting value, not
# permanent config. To rotate without a redeploy:
#     python scripts/set_bedrock_key.py <new-key>
# That updates this machine AND the deployed service (via POST /admin/llm-key).
# Check what's loaded with:  python scripts/set_bedrock_key.py --status
#
# AWS_BEARER_TOKEN_BEDROCK is also accepted — it's the name the Anthropic SDK itself
# reads, so an existing export works without renaming anything.
BEDROCK_API_KEY=bedrock-api-key-...

# Region for the Bedrock endpoint. Claude Opus 5 is in us-east-1.
# AWS_REGION=us-east-1

# Where the rotated key is cached so a restart doesn't lose it. Defaults to the platform
# temp directory (/tmp in the container, %TEMP% on Windows) — leave it unset unless you
# need a specific path.
# MUST be outside the repo: state/ and output/ are committed to a public repo, and the
# code refuses a path inside it rather than risk publishing a credential.
# BEDROCK_KEY_FILE=/tmp/bedrock_key.json

# --- First-party Anthropic API (only when LLM_PROVIDER=anthropic) ------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Notion ------------------------------------------------------------------
# Create an INTERNAL integration at https://www.notion.so/my-integrations (not a public
# one — an OAuth access token expires and needs refreshing). The token starts with `ntn_`.
#
# Then open the Resume Master page → ⋯ → Connections → add the integration. Without that
# share step every REST read returns 404, even with a perfectly valid token. This is the
# single most common setup mistake; `python scripts/check_notion.py` tests for it.
NOTION_TOKEN=ntn_...

# The seven database ids are already defaulted in pipeline/config.py, pointing at the
# databases under the Resume Master page. Override only if you rebuild them.
# These are database ids, NOT data-source (collection://) ids — only the former works
# with /v1/databases/{id}/query; a collection id returns a misleading 404.
# NOTION_MASTER_PAGE_ID=3b525b0d-3537-813e-bc87-e48ed8f823bc
# NOTION_DB_EXPERIENCES=16b31fc42e78450a9e4da4ae059ace67
# NOTION_DB_PROJECTS=e47f32a6ead94d2a997be12a746b192d
# NOTION_DB_EDUCATION=2a9b9e512a844f2f86605ec86a0eebaa
# NOTION_DB_SKILLS=53723269fbbf41e09db6a97accc6c9ff
# NOTION_DB_PUBLICATIONS=8481129268544760b97339b7605f3fb7
# NOTION_DB_PROFILE=05427da04c764d5b885abea89967a29a
# NOTION_DB_RUNS=6009f1883b3345caa2f05a051a0b5c67
# NOTION_VERSION=2022-06-28

# --- Slack -------------------------------------------------------------------
# Bot scopes: chat:write, commands, im:write
# (the code only calls chat.postMessage — artifacts live in Notion and the download links)
#
# Both values come FROM Slack; nothing here is ever entered into the Slack dashboard.
# Bot User OAuth Token, from OAuth & Permissions after installing the app:
SLACK_BOT_TOKEN=xoxb-...
# Basic Information → App Credentials → Signing Secret:
SLACK_SIGNING_SECRET=...
# Where notifications go. Your own member ID (U...) for a DM, or a channel ID (C...) —
# if a channel, invite the bot or chat.postMessage returns not_in_channel.
SLACK_DM_CHANNEL=U...

# --- GitHub ------------------------------------------------------------------
# Fine-grained PAT with Contents: Read and write on the Resume_pipeline repo. Needed
# because git is the database: state/ and output/ are committed (see pipeline/state.py).
GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=shane01526/Resume_pipeline
# Branch the entrypoint checks out and publish.py pushes to.
# GIT_BRANCH=main
# Identity on the commits the pipeline makes.
# GIT_AUTHOR_NAME=resume-pipeline
# GIT_AUTHOR_EMAIL=bot@resume-pipeline.local

# --- Web / approval ----------------------------------------------------------
# Must match the deployed URL, or Slack approval links point at localhost. On Render this
# is filled from RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=https://resume-pipeline.onrender.com
# Signs approval links so a guessed run ID can't publish. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_HMAC_SECRET=
# Authenticates the cron job's POST /api/runs. Generate the same way.
TRIGGER_TOKEN=
# How long a pending run stays approvable before it self-expires.
# APPROVAL_TIMEOUT_HOURS=72

# --- Storage -----------------------------------------------------------------
# Where run state lives: "local" (filesystem) or "github" (Contents API).
#
# Cloud Run REQUIRES "github": its disk is ephemeral and consecutive requests can land on
# different instances, so a run created by one request must be readable by the next.
# Render and local development can use "local", where state/ is a committed directory.
# STORAGE_BACKEND=local

# --- Rendering ---------------------------------------------------------------
# Comma-separated subset of: html,latex,docx
# "latex" produces two files per language: resume.tex (the Overleaf-editable source, which
# needs no external tool) and resume.latex.pdf (compiled, needs Tectonic on PATH).
# RENDERERS=html,latex,docx
# Resolution of the page images on the diff page.
# PDFTOPPM_DPI=110
# Override if the Tectonic binary isn't on PATH under that name.
# TECTONIC_BIN=tectonic
