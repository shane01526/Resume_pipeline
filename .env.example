# Copy to .env for local development. On Render, set these in the dashboard instead.
# Defaults for the NOTION_DB_* values are already baked into pipeline/config.py, so you
# only need to override them if you rebuild the databases.

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5

# --- Notion ------------------------------------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations, then open
# the Resume Master page → ⋯ → Connections → add the integration. Without that share
# step every REST read returns 404, even with a valid token.
NOTION_TOKEN=ntn_...

# --- Slack -------------------------------------------------------------------
# Bot scopes: chat:write, commands, im:write
# (the code only calls chat.postMessage — artifacts live in Notion and the download links)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Your own user ID (U...) for a DM, or a channel ID (C...).
SLACK_DM_CHANNEL=U...

# --- GitHub ------------------------------------------------------------------
# Fine-grained PAT with Contents: Read and write on the Resume_pipeline repo.
GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=shane01526/Resume_pipeline

# --- Web / approval ----------------------------------------------------------
# Must match the Render service URL, or Slack approval links point at localhost.
PUBLIC_BASE_URL=https://resume-pipeline.onrender.com
# Signs approval links so a guessed run ID can't publish. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_HMAC_SECRET=
# Authenticates the cron job's POST /api/runs. Generate the same way.
TRIGGER_TOKEN=
# APPROVAL_TIMEOUT_HOURS=72

# --- Rendering ---------------------------------------------------------------
# Comma-separated subset of: html,latex,docx
# RENDERERS=html,latex,docx
# PDFTOPPM_DPI=110
